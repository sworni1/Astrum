{
  "name": "astrum",
  "version": "1.0.0",
  "description": "astrum project",
  "author": "sworni",
  "scripts": {
    "dev": "docker start astrum-db && turbo dev",
    "db:generate": "pnpm --filter @astrum/db db:generate",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test && bash ./scripts/test-python.sh",
    "test:py": "bash ./scripts/test-python.sh",
    "quality-gate": "turbo quality-gate",
    "format": "prettier --write --ignore-unknown \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" \"!**/node_modules/**\" \"!**/.next/**\" \"!**/dist/**\" \"!**/coverage/**\" \"!**/generated/**\"",
    "format:check": "prettier --check --ignore-unknown \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" \"!**/node_modules/**\" \"!**/.next/**\" \"!**/dist/**\" \"!**/coverage/**\" \"!**/generated/**\"",
    "dev:customer": "turbo dev --filter=@astrum/customer",
    "dev:api": "turbo dev --filter=@astrum/api",
    "dev:auth": "turbo dev --filter=@astrum/auth",
    "dev:business": "turbo dev --filter=@astrum/business",
    "prisma:generate": "turbo prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @astrum/db exec prisma migrate dev",
    "prisma:migrate:deploy": "pnpm --filter @astrum/db exec prisma migrate deploy",
    "prisma:studio": "pnpm --filter @astrum/db exec prisma studio",
    "prisma:seed": "pnpm --filter @astrum/db seed",
    "db:up": "docker compose up astrum-db -d",
    "db:rm": "docker compose rm astrum-db -s -f -v",
    "db:restart": "pnpm db:rm && pnpm db:up && timeout 2 && pnpm prisma:migrate:deploy",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky",
    "mcp:check": "pwsh ./scripts/mcp-health-check.ps1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.9.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msw",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@12.8.1"
}
