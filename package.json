{
  "name": "astrum",
  "version": "1.0.0",
  "description": "astrum project",
  "author": "sworni",
  "scripts": {
    "dev": "docker start astrum-db && turbo dev",
    "db:generate": "pnpm --filter @astrum/db db:generate",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "quality-gate": "turbo quality-gate",
    "format": "biome format --write --ignore-unknown \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" \"!**/node_modules/**\" \"!**/.next/**\" \"!**/dist/**\" \"!**/coverage/**\" \"!**/generated/**\"",
    "format:check": "biome format --check --ignore-unknown \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" \"!**/node_modules/**\" \"!**/.next/**\" \"!**/dist/**\" \"!**/coverage/**\" \"!**/generated/**\"",
    "dev:customer": "turbo dev --filter=@astrum/customer",
    "dev:api": "turbo dev --filter=@astrum/api",
    "dev:auth": "turbo dev --filter=@astrum/auth",
    "prisma:generate": "turbo prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @astrum/db exec prisma migrate dev",
    "prisma:migrate:deploy": "pnpm --filter @astrum/db exec prisma migrate deploy",
    "prisma:studio": "pnpm --filter @astrum/db exec prisma studio",
    "prisma:seed": "pnpm --filter @astrum/db seed",
    "db:up": "docker compose up astrum-db -d",
    "db:rm": "docker compose rm astrum-db -s -f -v",
    "db:restart": "pnpm db:rm && pnpm db:up && timeout 2 && pnpm prisma:migrate:deploy",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f --tail=100",
    "docker:prod:scale": "docker compose -f docker-compose.prod.yml up -d --no-deps --scale api=3 api",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": ["biome format --write"]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
