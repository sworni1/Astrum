# ============================================================
# Runtime environment for docker-compose.prod.yml
# ============================================================
# Copy to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored and is mounted into every container, so it must hold
# everything the services read at runtime. Hostnames are compose service names,
# never localhost.

# ---------- Postgres ----------
POSTGRES_USER=astrum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astrum
# Host is the compose service name `db`, not localhost.
DATABASE_URL=postgresql://astrum:change-me@db:5432/astrum?schema=public

# ---------- JWT ----------
# Must be identical for customer, api and auth. At least 32 characters.
JWT_SECRET=change-me-in-production-at-least-32-chars

# ---------- Prisma connection pool ----------
# Connections used by one replica. Keep replicas x DB_POOL_SIZE comfortably
# below the Postgres limit: 3 api x 10 + 1 auth x 10 = 40 of 100.
DB_POOL_SIZE=10

# ---------- Service discovery inside the compose network ----------
# The gateway mounts /api/auth and keeps that prefix, so the value ends with it.
AUTH_SERVICE_URL=http://auth:4580/api/auth

# Seller order APIs stay disabled until businesses have assigned owners.
SELLER_ORDER_WORKFLOW_ENABLED=false

# ---------- Redis (session store) ----------
# Required by api and auth: the process throws at boot without it, there is no
# localhost default. The password inside the URL must be URL encoded, so a
# generated secret holding @, : or / still forms a valid URL (@ becomes %40).
REDIS_URL=redis://:change-me@redis:6379
# Passed to the redis service as --requirepass; must match the URL above.
REDIS_PASSWORD=change-me

# ---------- Customer ----------
# Both are baked into the Next.js build (build args in compose), listed here so
# the expected values are visible in one place.
API_GATEWAY_INTERNAL_URL=http://proxy:3580
NEXT_PUBLIC_API_GATEWAY_URL=/api-gateway

# ---------- Broker and mail (account confirmation) ----------
# Required by api, auth and worker: the process throws at boot without it.
# Host is the compose service name `rabbitmq`; credentials come from
# RABBITMQ_USER / RABBITMQ_PASSWORD below, which the broker also reads.
RABBITMQ_URL=amqp://astrum:change-me@rabbitmq:5672
RABBITMQ_USER=astrum
RABBITMQ_PASSWORD=change-me
# Mail submission URL of the real relay. Absent means the worker writes the
# letter to its log and to MAIL_OUTBOX_DIR instead of sending it.
# The stack ships a mail catcher: set smtp://mailpit:1025 and read the
# letter at http://localhost:8025. A real deployment points this at its relay.
SMTP_URL=smtp://change-me:change-me@smtp.example.com:587
MAIL_FROM=no-reply@example.com
# Public storefront origin: the confirmation link and the redirect target. The
# payment return URLs are built from it too (spec 0015, AC-14).
STOREFRONT_URL=https://example.com
# ---------- Payment (Stripe, test mode only) ----------
# Test mode secret key (sk_test_...): Dashboard -> Developers -> API keys. With
# either value missing the gateway boots, logs one payment.provider.unconfigured
# warning and answers 502 PAYMENT_PROVIDER_UNAVAILABLE on the pay route.
STRIPE_SECRET_KEY=sk_test_replace_me
# Callback signing secret (whsec_...). In production it is the endpoint secret of
# the dashboard webhook https://$DOMAIN/api/payments/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
WORKER_PORT=5580
MAIL_OUTBOX_DIR=/tmp/mail

# ---------- Public entry ----------
# The hostname Caddy serves and the origin the provider calls back on. Compose
# interpolates it from the project .env, so set the same value there.
DOMAIN=example.com
