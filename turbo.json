{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "persistent": true,
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "prisma:generate": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "check-types": {
      "dependsOn": ["^db:generate", "^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "quality-gate": {
      "dependsOn": ["check-types", "lint", "test"],
      "cache": false
    },
    "start": {
      "dependsOn": ["build"]
    }
  }
}
