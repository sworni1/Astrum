# Шаблон переменных окружения для apps/auth-astrum (NestJS Auth)
# Скопируйте в .env и заполните реальные значения.

# Подключение к Postgres
DATABASE_URL=postgresql://astrum:change-me@localhost:5432/astrum?schema=public

# Секрет JWT (должен совпадать с api-astrum)
JWT_SECRET=change-me-in-production

# Порт Auth-сервиса
AUTH_PORT=4580

# Хранилище сессий (обязательно: без переменной сервис не стартует)
REDIS_URL=redis://localhost:6379

# Брокер (обязательно: регистрация публикует событие подтверждения)
RABBITMQ_URL=amqp://localhost:5672

# Публичный адрес витрины (обязательно: на него ведёт редирект после клика)
STOREFRONT_URL=http://localhost:3000
