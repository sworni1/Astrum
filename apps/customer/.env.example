# Шаблон переменных окружения для apps/customer (Next.js фронтенд)
# Скопируйте в .env.local для локальной разработки и в .env.production для прода.

# URL API-шлюза, доступный из браузера. Попадает в клиентский бандл (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3580/api

# Секрет JWT — используется только на сервере (middleware, route handlers)
JWT_SECRET=change-me-in-production

# Окружение Next.js
NODE_ENV=development