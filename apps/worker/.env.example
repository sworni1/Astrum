# Worker runtime, copied to .env for a local run outside docker.
DATABASE_URL=postgresql://astrum:change-me@localhost:5432/astrum?schema=public

# Required: the worker consumes account events from this broker.
RABBITMQ_URL=amqp://localhost:5672

# Required: the sender address of the confirmation letter.
MAIL_FROM=no-reply@astrum.local

# Required: the confirmation link points at the storefront origin.
STOREFRONT_URL=http://localhost:3000

# Optional: absent means the development transport (log plus a file).
SMTP_URL=smtp://localhost:1025

WORKER_PORT=5580
MAIL_OUTBOX_DIR=./tmp/mail
