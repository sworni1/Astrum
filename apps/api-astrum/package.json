{
  "name": "@astrum/api",
  "scripts": {
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "check-types": "tsc --noEmit",
    "start:dev": "dotenv run -- tsx watch src/server.ts",
    "dev": "dotenv run -- tsx watch src/server.ts",
    "start:prod": "dotenv run -f .env.prod -- tsx dist/src/server.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "echo \"[api-astrum] no ESLint configured — skipping\" && exit 0",
    "format": "echo \"[api-astrum] no Prettier configured — skipping\" && exit 0",
    "format:check": "echo \"[api-astrum] no Prettier configured — skipping\" && exit 0",
    "quality-gate": "pnpm check-types && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqplib": "^2.2.1",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.1",
    "http-status-codes": "^2.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv-cli": "^11.1.0",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
