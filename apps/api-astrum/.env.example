# Шаблон переменных окружения для apps/api-astrum (Express API-шлюз)
# Скопируйте в .env и заполните реальные значения.

# Подключение к Postgres
DATABASE_URL=postgresql://astrum:change-me@localhost:5432/astrum?schema=public

# Секрет для подписи/проверки JWT (должен совпадать с auth-astrum)
JWT_SECRET=change-me-in-production

# URL соседних микросервисов
AUTH_SERVICE_URL=http://localhost:4580/api/auth

# Хранилище сессий (обязательно: без переменной сервис не стартует)
REDIS_URL=redis://localhost:6379

# Порт API (опционально, по умолчанию 3580)
API_PORT=3580

# Брокер (обязательно: смена почты публикует событие подтверждения)
RABBITMQ_URL=amqp://localhost:5672

# Публичный адрес витрины не нужен: ссылку собирает воркер