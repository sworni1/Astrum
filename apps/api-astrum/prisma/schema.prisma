generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(uuid())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  email               String              @unique
  passwordhash        String
  gender              Gender
  isDeleted           Boolean             @default(false)
  nickName            String?
  preferredCategories String[]
  dateOfBirth         DateTime
  lastViewedProduct   LastViewedProduct[]
  Review              Review[]
}

model LastViewedProduct {
  id          String  @id @default(uuid())
  viewingTime Int
  productId   String
  userId      String?
  User        User?   @relation(fields: [userId], references: [id])
}

model Impression {
  id        String   @id @unique @default(uuid())
  stars     Float    @default(0)
  comment   String
  photos    String[]
  userId    String
  productId String
  Product   Product  @relation(fields: [productId], references: [id])
}

model WishlistItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  productId String

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  productId String
  quantity  Int      @default(1)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Product {
  id            String            @id @default(uuid())
  businessId    String
  createdAt     DateTime          @default(now())
  name          String
  quantity      Int
  description   String?
  price         Float
  discount      Float?
  stars         Float             @default(0)
  popularity    Float             @default(0)
  category      ProductCategory
  subcategory   String?
  currency      Currency
  isDeleted     Boolean           @default(false)
  isOutOfStock  Boolean           @default(false)
  visibility    ProductVisibility @default(Draft)
  status        ProductStatus     @default(Draft)
  images        String[]
  previewImage  String
  sales         Int               @default(0)
  views         Int               @default(0)
  reviewCount   Int               @default(0)
  averageRating Float             @default(0)
  impressions   Impression[]
  properties    ProductProperty[]
  Review        Review[]
}

model ProductProperty {
  id        String        @id @default(uuid())
  label     PropertyLabel
  value     String
  productId String
  Product   Product       @relation(fields: [productId], references: [id])
}

model Order {
  id               String         @id @default(cuid())
  userId           String
  totalPrice       Float
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus  @default(PENDING)
  paymentDetails   String?
  status           OrderStatus    @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deliveryAddress  String
  deliveryDate     DateTime
  shippingMethodId String
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id])
  OrderItem        OrderItem[]
}

model OrderItem {
  id           String          @id @default(cuid())
  productId    String
  previewImage String
  name         String
  quantity     Int
  price        Float
  orderId      String
  receiptDate  DateTime?
  status       OrderItemStatus @default(PENDING)
  userId       String
  order        Order           @relation(fields: [orderId], references: [id])
  Review       Review?
}

model ShippingMethod {
  id    String  @id @default(cuid())
  name  String  @unique
  price Float
  Order Order[]
}

model Review {
  id             String           @id @default(uuid())
  userId         String
  productId      String
  orderItemId    String           @unique
  rating         Int              @db.SmallInt
  qualityRating  Int              @db.SmallInt
  deliveryRating Int              @db.SmallInt
  accuracyRating Int              @db.SmallInt
  comment        String
  photos         String[]         @default([])
  status         ReviewStatus     @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt 
  OrderItem      OrderItem        @relation(fields: [orderItemId], references: [id])
  Product        Product          @relation(fields: [productId], references: [id])
  User           User             @relation(fields: [userId], references: [id])
  ReviewResponse ReviewResponse[]

  @@index([createdAt])
  @@index([productId, status])
  @@index([userId])
}

model ReviewResponse {
  id         String   @id @default(uuid())
  reviewId   String
  businessId String
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Review     Review   @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
}

enum PaymentMethod {
  CASH
  CARD_ON_DELIVERY
  ONLINE_CARD
  PAYPAL
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  OUT_OF_STOCK
  CANCELLED
  SHIPPED
  DELIVERED
  RETURNED
  BACKORDERED
  REPLACED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELED
}

enum PropertyLabel {
  Color
  Size
  Material
  Brand
  Weight
  Dimensions
  Warranty
  EnergyEfficiency
  StorageCapacity
  OperatingSystem
  Processor
  GraphicsCard
  ScreenSize
  BatteryLife
  Type
  Power
  Features
  Control
  NoiseLevel
  PowerSource
  Display
  Capacity
  Installation
  Speed
  Construction
  RAM
  Connectivity
}

enum ProductCategory {
  Electronics
  Fashion
  Home
  Food
  Beauty
  Books
  Sports
  Toys
  Automotive
  Office
}

enum Currency {
  RUB
  USD
}

enum ProductStatus {
  Draft
  Published
  Discontinued
}

enum ProductVisibility {
  Public
  Private
  Archived
  Draft
}

enum Gender {
  Male
  Female
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
