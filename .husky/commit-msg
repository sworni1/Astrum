#!/bin/sh
# Validate conventional commit format
if ! grep -qE "^(feat|fix|docs|style|refactor|test|chore|ci|build|perf)(\(.+\))?!?: .+" "$1"; then
  echo "Commit message must follow conventional commit format."
  echo "Examples:"
  echo "  feat(api): add user endpoint"
  echo "  fix(auth): handle expired tokens"
  echo "  docs: update CLAUDE.md"
  echo ""
  echo "Types: feat, fix, docs, style, refactor, test, chore, ci, build, perf"
  exit 1
fi
