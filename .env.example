# ============================================================
# Шаблон переменных окружения для корня монорепо Astrum
# ============================================================
# Скопируйте в .env и заполните реальные значения:
#   cp .env.example .env
#
# Docker compose подхватывает значения отсюда автоматически.
# Значения используются также приложениями через dotenv-cli.

# ---------- Postgres ----------
POSTGRES_PORT=5432
POSTGRES_USER=astrum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astrum
DATABASE_URL=postgresql://astrum:change-me@localhost:5432/astrum?schema=public

# ---------- Порты приложений (дев-режим, вне docker) ----------
API_PORT=3580
AUTH_PORT=4580
# Витрина читает PORT (её задаёт Next), отдельная переменная не нужна

# ---------- JWT ----------
# ОБЯЗАТЕЛЬНО смените в production. Длина >= 32 символа.
JWT_SECRET=change-me-in-production-at-least-32-chars

# ---------- Пул Prisma на одну реплику ----------
# Бюджет: реплики x DB_POOL_SIZE ниже лимита соединений Postgres.
DB_POOL_SIZE=10

# ---------- Redis (хранилище сессий) ----------
# Обязательно для api и auth: без этой переменной процесс падает на старте.
# Дев-файл compose публикует порт 6379, поэтому локально это localhost.
# Внутри сети compose значение — redis://astrum-redis:6379.
REDIS_URL=redis://localhost:6379

# ---------- Межсервисные URL ----------
# В docker compose используются имена сервисов, в локальной разработке — localhost.
# Прокси уже смонтирован на /api/auth и сохраняет этот префикс,
# поэтому значение обязано заканчиваться на /api/auth.
AUTH_SERVICE_URL=http://localhost:4580/api/auth
API_GATEWAY_INTERNAL_URL=http://localhost:3580

# ---------- Customer (Next.js public — попадают в клиентский бандл) ----------
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3580/api

# ---------- Broker и почта (подтверждение аккаунта) ----------
# Обязательно для api, auth и worker: без RABBITMQ_URL процесс падает на старте.
# Дев-файл compose публикует 5672 и заводит пользователя astrum с паролем
# из RABBITMQ_PASSWORD (по умолчанию change-me); гость guest/guest удалён.
RABBITMQ_URL=amqp://astrum:change-me@localhost:5672
# SMTP от Mailpit (порт 1025). Если SMTP_URL убрать, worker пишет письмо
# в лог и в файл под MAIL_OUTBOX_DIR вместо отправки.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@astrum.local
# Публичный адрес витрины: из него собирается ссылка подтверждения и на него
# auth перенаправляет после клика.
STOREFRONT_URL=http://localhost:3000
# ---------- Оплата (Stripe, только тестовый режим) ----------
# Секретный ключ тестового режима (sk_test_...): Dashboard -> Developers -> API keys.
# Без него шлюз всё равно поднимается, пишет одно предупреждение
# payment.provider.unconfigured и отвечает 502 PAYMENT_PROVIDER_UNAVAILABLE.
STRIPE_SECRET_KEY=sk_test_replace_me
# Секрет подписи колбэков (whsec_...). В разработке его печатает
# `stripe listen --forward-to http://localhost:3580/api/payments/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Публичный вход Caddy: пустое значение означает localhost и обычный HTTP.
DOMAIN=localhost
WORKER_PORT=5580
MAIL_OUTBOX_DIR=./tmp/mail