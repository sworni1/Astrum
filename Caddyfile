# Public entry point plus the internal gateway load balancer.
# The default address is scheme-prefixed so a local run stays on plain HTTP;
# set DOMAIN=example.com in production and Caddy provisions TLS automatically.

{$DOMAIN:http://localhost} {
	encode zstd gzip

	# The payment provider calls back here, so this path goes to the api replicas
	# instead of the storefront (spec 0015, AC-1). Everything else stays with the
	# storefront, which reaches the gateway through its /api-gateway rewrite.
	handle /api/payments/stripe/webhook {
		reverse_proxy {
			dynamic a api 3580 {
				refresh 5s
			}
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
			health_uri /health
			health_interval 5s
			health_timeout 2s
		}
	}

	handle {
		reverse_proxy {
			dynamic a customer 3000 {
				refresh 5s
			}
			lb_policy round_robin
			# Retry on another replica while the health check has not caught up yet.
			lb_try_duration 5s
			lb_try_interval 250ms
			health_uri /health
			health_interval 5s
			health_timeout 2s
		}
	}
}

# Internal only: never published to the host, reached as proxy:3580 inside the network.
:3580 {
	reverse_proxy {
		dynamic a api 3580 {
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /health
		health_interval 5s
		health_timeout 2s
	}
}
