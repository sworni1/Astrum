{
  "name": "@astrum/db",
  "version": "1.0.0",
  "description": "",
  "exports": {
    "./client": {
      "types": "./dist/generated/prisma/client.d.ts",
      "default": "./dist/generated/prisma/client.js"
    },
    "./enums": {
      "types": "./dist/generated/prisma/enums.d.ts",
      "default": "./dist/generated/prisma/enums.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "db:generate": "prisma generate",
    "prisma:generate": "prisma generate",
    "build": "prisma generate && node scripts/writeSchemaHash.mjs && tsc -p tsconfig.build.json",
    "lint": "echo \"[astrum-db] no ESLint configured — skipping\" && exit 0",
    "format": "echo \"[astrum-db] no Prettier configured — skipping\" && exit 0",
    "format:check": "echo \"[astrum-db] no Prettier configured — skipping\" && exit 0",
    "check-types": "prisma generate && tsc -p tsconfig.check.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "verify:build": "node scripts/verifyBuild.mjs",
    "quality-gate": "pnpm check-types && pnpm test && pnpm verify:build",
    "prisma:deploy": "prisma migrate deploy && prisma generate",
    "seed:excel": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs prisma/seedFromExcel.ts",
    "assign-business": "tsx scripts/assignBusiness.ts",
    "pickup-point": "tsx scripts/pickupPoint.ts",
    "user-role": "tsx scripts/userRole.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
