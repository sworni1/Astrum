{
  "name": "@astrum/db",
  "version": "1.0.0",
  "description": "",
  "main": "./lib/index.ts",
  "types": "./lib/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "default": "./lib/index.ts",
      "*": "./generated/prisma/client/*"
    },
    "./prisma": {
      "types": "./lib/prisma.ts",
      "default": "./lib/prisma.ts"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "prisma:generate": "prisma generate",
    "build": "prisma generate",
    "lint": "echo \"[astrum-db] no ESLint configured — skipping\" && exit 0",
    "format": "echo \"[astrum-db] no Prettier configured — skipping\" && exit 0",
    "format:check": "echo \"[astrum-db] no Prettier configured — skipping\" && exit 0",
    "check-types": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "quality-gate": "pnpm check-types && pnpm test",
    "prisma:deploy": "prisma migrate deploy && prisma generate",
    "seed:excel": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs prisma/seedFromExcel.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.7.0",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "prisma": "^7.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}