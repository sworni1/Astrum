{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2023",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "lib/**/*.ts",
    "generated/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
